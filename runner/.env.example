# Keep this file local. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Identifies this process in audit events. Use a new value per machine/service.
SIGNAL_RUNNER_ID=local-rehearsal

# Milestone 4 must stay true. The worker will reject any attempt to open a real URL.
RUNNER_REHEARSAL_ONLY=true
RUNNER_MAX_STEPS=24
RUNNER_HEADLESS=true
